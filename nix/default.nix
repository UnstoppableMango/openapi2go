{
  buildGoApplication,
  fetchurl,
  lib,
  ginkgo,
  git,
  version,
}:
let
  petstoreSpec = fetchurl {
    # Pinned to a swagger-petstore commit: the live petstore3.swagger.io
    # endpoint is regenerated by the server and its bytes drift.
    url = "https://raw.githubusercontent.com/swagger-api/swagger-petstore/5cb909fc7780bc708151bce0014939acba8b212a/src/main/resources/openapi.yaml";
    hash = "sha256-Zc/i6IJsgdsO6jTFHRjaOjBa5IQPGneM1juJ05bvtoc=";
  };
in
buildGoApplication {
  pname = "openapi2go";
  inherit version;

  src = lib.cleanSource ../.;
  modules = ./gomod2nix.toml;

  nativeCheckInputs = [
    ginkgo
    git
  ];

  checkPhase = ''
    mkdir bin && cp ${petstoreSpec} bin/petstore.yaml
    ginkgo run -r
  '';
}
